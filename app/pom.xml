<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.usac.jobseeker</groupId>
        <artifactId>jobseeker-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>app</artifactId>
    <packaging>jar</packaging>

    <name>app</name>
    <description>El único desplegable (ADR-0026): @SpringBootApplication, la configuración transversal y las pruebas de arquitectura de los límites entre módulos (ADR-0015). No contiene lógica de negocio.</description>

    <dependencies>
        <!-- Los módulos de negocio son bibliotecas; este módulo las reúne en un solo proceso. -->
        <dependency>
            <groupId>com.usac.jobseeker</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.usac.jobseeker</groupId>
            <artifactId>auth-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.usac.jobseeker</groupId>
            <artifactId>cv-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.usac.jobseeker</groupId>
            <artifactId>job-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.usac.jobseeker</groupId>
            <artifactId>matching-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.usac.jobseeker</groupId>
            <artifactId>ats-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.usac.jobseeker</groupId>
            <artifactId>tracker-module</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- ADR-0010: OpenAPI generado del código (code-first), un solo documento para todo el desplegable. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- ADR-0011: límite de tasa con cubos de fichas guardados en Redis. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-lettuce</artifactId>
        </dependency>
        <!-- ADR-0021: almacén de archivos por el protocolo S3. Sin Netty ni Apache: el cliente HTTP
             del JDK basta para subidas de pocos megabytes y no arrastra otra pila de red. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>
        <!-- ADR-0012: métricas y salud. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Seguridad (ADR-0020): cliente OIDC de Clavaris para la web, servidor de recursos para la API. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
        </dependency>
        <!-- Servidor de recursos para `/api/v1/**` (ADR-0020, superficie B): valida los Bearer de Clavaris. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- Sesión web del lado del servidor sobre Redis (ADR-0020). En Boot 4 `spring.session.*` no
             configura nada: se declara @EnableRedisIndexedHttpSession (DistributedSessionConfiguration). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <!-- Datos: Flyway es la única fuente de verdad del esquema (data-model.md §2, ADR-0027). La
             persistencia es JDBC explícito con JdbcClient, sin JPA (ADR-0032). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Postgres 17 con pgvector, el mismo que Supabase ofrece (ADR-0028), para probar las migraciones. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ADR-0015: ArchUnit corre como una prueba más de `mvn verify`. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Las clases de ejemplo de las pruebas de arquitectura usan @Entity y @Transactional.
             `spring-tx` ya llega por spring-jdbc. Sin alcance `test` a propósito: una declaración
             directa con ese alcance pisa el alcance normal de una dependencia transitiva y la deja
             fuera del jar ejecutable, y las pruebas no lo notan porque usan su propio classpath. -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Sin esta ejecución el jar sale sin manifiesto (hallazgo 2 del spike R13). -->
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
