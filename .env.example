# Copiar a .env y completar con valores reales solo en local. Nunca versionar .env.
# Este archivo lista solo nombres de variables: sin valores ni credenciales.
#
# Criterio (ADR-0011, ADR-0020): aquí van únicamente los SECRETOS y los puntos de conexión que
# cambian de un entorno a otro. Lo ajustable y con valor por defecto (margen de prueba de vida,
# tiempos de espera hacia Clavaris, archivalDelayDays, accountDeletionGracePeriodDays, pesos del
# score, límites de tasa) vive en application-*.yml, nunca aquí ni escrito en el código.
# scripts/check_env_drift.py comprueba en CI que toda ${VARIABLE} usada por la configuración
# esté declarada en este archivo.

# ---- Selector de perfil de Spring ----
SPRING_PROFILES_ACTIVE=

# ---- Postgres local (Docker, perfil dev) ----
DB_DEV_HOST=
DB_DEV_PORT=
DB_DEV_NAME=
DB_DEV_USER=
DB_DEV_PASSWORD=

# ---- Supabase (solo perfil prod — Postgres gestionado) ----
# La aplicación usa el pooler en modo transacción (puerto 6543); Flyway necesita la conexión
# directa o en modo sesión (5432) por sus bloqueos de sesión (ADR-0027, 09-… §3).
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_DIRECT_HOST=
SUPABASE_DB_DIRECT_PORT=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Redis (sesiones web, caché de scores, buckets de rate limit — ADR-0011, ADR-0020) ----
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ---- Ollama (IA local) ----
OLLAMA_HOST=
OLLAMA_PORT=
# Modelo de embeddings vigente (ADR-0018); cambiarlo exige el procedimiento de data-model.md §5.1.
OLLAMA_EMBEDDING_MODEL=

# ---- API de Claude (uso selectivo) ----
CLAUDE_API_KEY=

# ---- Clavaris: cliente OIDC (proveedor de identidad externo — ADR-0020) ----
# JobSeeker solo valida y consume tokens; nunca los firma, por eso aquí no hay secreto de firma.
# El issuer URI determina el descubrimiento OIDC y la consulta del JWKS.
CLAVARIS_ISSUER_URI=
CLAVARIS_CLIENT_ID=
CLAVARIS_CLIENT_SECRET=
# Audiencias (`aud`) aceptadas en los Bearer de /api/v1, separadas por comas; el validador propio
# rechaza cualquier otra. Vacío = solo el `client_id` de JobSeeker (lo normal en el MVP).
CLAVARIS_ALLOWED_AUDIENCES=
# Orígenes CORS permitidos para la API, separados por comas y sin comodines. Vacío = CORS cerrado.
API_CORS_ALLOWED_ORIGINS=
# Tolerancia de reloj para `exp` y `nbf` de los Bearer, en segundos (0 a 120). Los tokens viven 300 s.
API_TOKEN_CLOCK_SKEW_SECONDS=

# ---- Clavaris: receptor de webhooks (/api/v1/webhooks/clavaris — ADR-0020) ----
# Se acepta cualquier firma v1 presente: durante la rotación del secreto Clavaris firma con el
# nuevo y con el anterior (24 h por defecto), así que se configuran los dos hasta que expire.
CLAVARIS_WEBHOOK_SECRET=
CLAVARIS_WEBHOOK_SECRET_PREVIOUS=

# ---- Clavaris: Secret Keys de servicio (API de administración) ----
# Una por función, con el mínimo de scopes (ADR-0020 regla 13).
# Lectura de estado de cuenta: scope platform:accounts:read-status; conciliación y comprobaciones previas.
CLAVARIS_SECRET_KEY_READ_STATUS_ID=
CLAVARIS_SECRET_KEY_READ_STATUS_SECRET=
# Borrado de cuentas (cascada de anonimización, BR-DATA-06, ADR-0013): scope platform:accounts:delete.
# Una Secret Key de la organización de JobSeeker, solo con ese scope (ADR-0013).
CLAVARIS_SECRET_KEY_ACCOUNT_DELETE_ID=
CLAVARIS_SECRET_KEY_ACCOUNT_DELETE_SECRET=

# ---- Sesión web (ADR-0020) ----
# Las sesiones se guardan en Redis (ver el bloque de Redis más arriba).
SESSION_IDLE_TIMEOUT_MINUTES=
SESSION_ABSOLUTE_TIMEOUT_HOURS=
# Cifrado en reposo del refresh token (AES-GCM). Varias claves con identificador `kid` para poder
# rotarlas sin invalidar las sesiones vivas: formato `kid:clave` separado por comas, con la clave en
# base64 de 32 bytes (AES-256). Genera una con `openssl rand -base64 32`; `scripts/dev-up.sh` la crea
# en desarrollo. Rotar: añade `k2:...` a la lista y pon `k2` como activa; retira `k1` cuando ninguna
# sesión viva (≤ 8 h) la use. Con Clavaris configurado y sin clave, la aplicación no arranca.
TOKEN_ENCRYPTION_ACTIVE_KID=
TOKEN_ENCRYPTION_KEYS=
# Prueba de vida de la sesión con el refresh token (ADR-0020). Vacío = valor por defecto.
# Renovación por sesión (≤ 15 min) y margen sin Clavaris (2 h; nunca más que el límite absoluto).
LIVENESS_RENEWAL_INTERVAL_MINUTES=
LIVENESS_CLAVARIS_UNAVAILABLE_MARGIN_HOURS=
# `false` fuerza el cierre inmediato ante cualquier fallo de renovación (incidente de seguridad).
LIVENESS_FAIL_OPEN_ENABLED=
# Un único reintento tras tiempo agotado; solo con `refreshTokenReuseGraceSeconds` en 30 s en Clavaris.
LIVENESS_RETRY_ONCE_WITHIN_GRACE=

# ---- Almacenamiento de archivos (ADR-0026) ----
# Supabase Storage (compatible con S3) en producción; MinIO en desarrollo local.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
CLAMAV_HOST=
CLAMAV_PORT=

# ---- Correo saliente (notificaciones) ----
# Mailpit en desarrollo local; proveedor transaccional en staging y producción.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---- Observabilidad (ADR-0012) ----
GRAFANA_ADMIN_PASSWORD=
