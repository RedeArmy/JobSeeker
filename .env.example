# Copiar a .env y completar con valores reales solo en local. Nunca versionar .env.
# Este archivo lista solo nombres de variables: sin valores ni credenciales.

# ---- Postgres local (Docker, perfil dev) ----
DB_DEV_HOST=
DB_DEV_PORT=
DB_DEV_NAME=
DB_DEV_USER=
DB_DEV_PASSWORD=

# ---- Redis (desarrollo) ----
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ---- Ollama (IA local) ----
OLLAMA_HOST=
OLLAMA_PORT=

# ---- API de Claude (uso selectivo) ----
CLAUDE_API_KEY=

# ---- Clavaris (proveedor de identidad OIDC externo — ADR-0020) ----
# JobSeeker solo valida y consume tokens; nunca los firma, por eso aquí no hay
# secreto de firma. El issuer URI determina el descubrimiento OIDC y la consulta del JWKS.
CLAVARIS_ISSUER_URI=
CLAVARIS_CLIENT_ID=
CLAVARIS_CLIENT_SECRET=
# Credenciales de servicio (client_credentials) para la API de administración de Clavaris:
# se usan solo en la cascada de anonimización de cuentas (BR-DATA-06, ADR-0013).
CLAVARIS_ADMIN_CLIENT_ID=
CLAVARIS_ADMIN_CLIENT_SECRET=

# ---- Sesión web (ADR-0020) ----
# Las sesiones se guardan en Redis (ver el bloque de Redis más arriba).
SESSION_IDLE_TIMEOUT_MINUTES=
SESSION_ABSOLUTE_TIMEOUT_HOURS=

# ---- Almacenamiento de archivos (ADR-0026) ----
# Supabase Storage (compatible con S3) en producción; MinIO en desarrollo local.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
CLAMAV_HOST=
CLAMAV_PORT=

# ---- Correo saliente (notificaciones) ----
# Mailpit en desarrollo local; proveedor transaccional en staging y producción.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---- Observabilidad (ADR-0012) ----
GRAFANA_ADMIN_PASSWORD=

# ---- Supabase (solo perfil prod — Postgres gestionado) ----
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Selector de perfil de Spring ----
SPRING_PROFILES_ACTIVE=
