<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.usac.jobseeker</groupId>
    <artifactId>jobseeker-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>jobseeker-parent</name>
    <description>POM padre del monolito modular JobSeeker. Fija versiones y la configuración de calidad del build; las dependencias de aplicación las declara cada módulo.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- ADR-0014: Java 25 (LTS), alineado con ../Clavaris y verificado en
             architecture-review-2026-11/05-verificacion-riesgos-java-25.md. -->
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- ADR-0014: Boot 3.4 salió del soporte OSS el 2025-12-31; 4.1.2 es la línea con la que
             ../Clavaris ya compila. Boot 4.1 termina el 2027-07-31: planificar una actualización menor. -->
        <spring-boot.version>4.1.2</spring-boot.version>

        <!-- Versiones fijadas y verificadas juntas en el spike R13 (10-spike-r13-sprint-0.md). Se
             declaran aquí solo para que ningún módulo las repita; una biblioteca no entra al
             classpath hasta que un módulo la declare como dependencia. -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <archunit.version>1.5.1</archunit.version>
        <springdoc.version>3.2.0</springdoc.version>
        <!-- La que trae springdoc 3.2.0: un módulo solo necesita las anotaciones, no el generador. -->
        <swagger-core.version>2.2.56</swagger-core.version>
        <!-- Solo pruebas: valida el OpenAPI exportado (ADR-0010, decisión 4). Más de dos semanas de publicada. -->
        <swagger-parser.version>2.1.47</swagger-parser.version>
        <bucket4j.version>8.22.0</bucket4j.version>
        <openhtmltopdf.version>1.1.114</openhtmltopdf.version>
        <!-- ADR-0021: cliente S3 del almacén de archivos, verificado con Java 25 en el spike V2
             (13-spike-almacenamiento-s3-y-clamav.md). Publicada hace más de dos semanas. -->
        <awssdk.version>2.58.0</awssdk.version>

        <!-- Herramientas de build compatibles con Java 25 (las anteriores fallan con classfile 69). -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <jacoco.version>0.8.16</jacoco.version>
        <spotless.version>3.11.0</spotless.version>
        <google-java-format.version>1.36.1</google-java-format.version>
        <pmd-plugin.version>3.28.0</pmd-plugin.version>
        <pmd.version>7.29.0</pmd.version>

        <!-- Pruebas de mutación (perfil `mutation`, fuera del build normal). Versiones con más de dos
             semanas de publicadas, como el resto de las herramientas. -->
        <pitest-maven.version>1.30.2</pitest-maven.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>

        <!-- SonarCloud: se ejecuta desde el CI (job «SonarCloud analysis»); el token llega como secreto. -->
        <sonar-maven-plugin.version>5.9.0.7382</sonar-maven-plugin.version>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.organization>redearmy</sonar.organization>
        <sonar.projectKey>RedeArmy_JobSeeker</sonar.projectKey>
        <!-- HTMX es código de terceros incluido tal cual (huella fijada en VendoredAssetsTest): analizarlo
             solo generaría hallazgos que no podemos corregir. -->
        <sonar.exclusions>**/static/js/htmx.min.js</sonar.exclusions>
        <!-- Por defecto el escáner solo lee el código Java. Con los recursos dentro, sigue los datos
             hasta las plantillas Thymeleaf y detecta XSS en ellas (hallazgos de Sonar del 21-nov y del
             27-nov-2026). Va aquí y no módulo a módulo porque las plantillas ya están en `app` y `cv` y
             llegarán con `ats` y `tracker`: un módulo nuevo queda analizado sin acordarse de nada.
             `common` no tiene recursos y lo sobrescribe, porque una carpeta que no existe hace fallar
             el análisis. -->
        <sonar.sources>src/main/java,src/main/resources</sonar.sources>
        <!-- La regla S1135 busca su marcador sin distinguir mayúsculas y, en comentarios en español, lo
             confunde con el cuantificador de totalidad, que se escribe igual. Se desactiva para Java,
             XML y HTML (las plantillas, desde que se analizan) y la reemplaza scripts/check-work-markers.sh, que sí exige dueño y razón
             (coding-standards.md §5). Ojo: este mismo comentario no puede usar esa palabra, porque
             el análisis de XML también la marcaba. -->
        <sonar.issue.ignore.multicriteria>pendienteJava,pendienteXml,pendienteHtml</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.pendienteJava.ruleKey>java:S1135</sonar.issue.ignore.multicriteria.pendienteJava.ruleKey>
        <sonar.issue.ignore.multicriteria.pendienteJava.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.pendienteJava.resourceKey>
        <sonar.issue.ignore.multicriteria.pendienteXml.ruleKey>xml:S1135</sonar.issue.ignore.multicriteria.pendienteXml.ruleKey>
        <sonar.issue.ignore.multicriteria.pendienteXml.resourceKey>**/*.xml</sonar.issue.ignore.multicriteria.pendienteXml.resourceKey>
        <sonar.issue.ignore.multicriteria.pendienteHtml.ruleKey>Web:S1135</sonar.issue.ignore.multicriteria.pendienteHtml.ruleKey>
        <sonar.issue.ignore.multicriteria.pendienteHtml.resourceKey>**/*.html</sonar.issue.ignore.multicriteria.pendienteHtml.resourceKey>
        <!-- Detección de duplicados: además de HTMX, se excluye la pareja contrato de `cv` y su copia
             anticorrupción en `matching`. Repetir los campos es deliberado: ARCH-04 prohíbe que un tipo
             de `cv` entre al dominio de `matching`, y compartirlo rompería el contexto acotado. -->
        <sonar.cpd.exclusions>**/static/js/htmx.min.js,**/cv/application/usecase/getprofilesnapshot/ProfileSnapshot.java,**/matching/domain/model/CandidateSignals.java</sonar.cpd.exclusions>
        <!-- Las migraciones `.sql` son de PostgreSQL, pero Sonar las analiza como PL/SQL (Oracle): marca
             `char` por no ser `VARCHAR2` o literales repetidos y avisa de un diccionario de datos que
             no aplica. Su linter correcto es squawk (CI, ADR-0027) y el estilo lo cubre
             MigrationConventionsTest; «-» desactiva el analizador PL/SQL por completo. -->
        <sonar.plsql.file.suffixes>-</sonar.plsql.file.suffixes>

        <!-- Vacío por defecto: JaCoCo lo rellena con su agente y Surefire lo concatena en su argLine. -->
        <argLine></argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Única fuente de versiones de bibliotecas (ADR-0014). Se importa, no se usa como <parent>,
                 para que este POM conserve la lista de módulos y la configuración del build. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger-core.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.parser.v3</groupId>
                <artifactId>swagger-parser</artifactId>
                <version>${swagger-parser.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j_jdk17-lettuce</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.openhtmltopdf</groupId>
                <artifactId>openhtmltopdf-pdfbox</artifactId>
                <version>${openhtmltopdf.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>common</module>
        <module>auth-module</module>
        <module>cv-module</module>
        <module>job-module</module>
        <module>matching-module</module>
        <module>ats-module</module>
        <module>tracker-module</module>
        <!-- ADR-0026: el único desplegable. Los módulos de negocio son bibliotecas; `app` aloja
             @SpringBootApplication, la configuración transversal y el único Dockerfile. -->
        <module>app</module>
    </modules>

    <build>
        <!-- El padre importa el BOM en vez de heredar de spring-boot-starter-parent, así que ningún
             plugin llega con versión ni configuración: se fijan aquí (hallazgo 1 del spike R13). -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!-- La opción de acceso nativo evita el aviso de la JVM 24+ cuando Netty llama a
                             System::loadLibrary (R10); EnableDynamicAgentLoading cubre el agente que
                             carga ByteBuddy (Mockito). -->
                        <argLine>@{argLine} --enable-native-access=ALL-UNNAMED -XX:+EnableDynamicAgentLoading</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <!-- Escáner de Sonar como plugin de Maven y no como acción de GitHub: así no hay que ampliar
                     las acciones permitidas del repositorio (solo las de GitHub). -->
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Formato del código (NFR-MAINT-02): `mvn spotless:apply` lo corrige, `verify` lo exige. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                        </googleJavaFormat>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Análisis estático: una violación rompe el build. Una excepción lleva
                 @SuppressWarnings("PMD.Regla") con un comentario que diga por qué. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${pmd-plugin.version}</version>
                <configuration>
                    <rulesets>
                        <ruleset>category/java/errorprone.xml</ruleset>
                    </rulesets>
                    <printFailingErrors>true</printFailingErrors>
                    <failOnViolation>true</failOnViolation>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


    <profiles>
        <!-- Mide si las pruebas detectan errores y no solo si pasan por el código: PIT cambia el código de
             producción (invierte una condición, quita una llamada, altera un valor devuelto) y comprueba que
             alguna prueba falle. Un mutante que sobrevive es una prueba que falta.
             Uso:  mvn -Pmutation -pl common,auth-module test-compile org.pitest:pitest-maven:mutationCoverage
             Informe: <módulo>/target/pit-reports/index.html. Es lento, por eso no corre con `mvn verify`. -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest-maven.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5-plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>com.usac.jobseeker.*</param>
                            </targetClasses>
                            <!-- STRONGER añade, entre otros, quitar condiciones y valores devueltos: sobreviven más
                                 mutantes y por eso detecta pruebas que solo parecen fuertes. -->
                            <mutators>
                                <mutator>STRONGER</mutator>
                            </mutators>
                            <!-- Las pruebas de adaptadores arrancan un contenedor: sin esto PIT las cuenta como
                                 «tiempo agotado» en vez de evaluarlas. -->
                            <timeoutConstant>120000</timeoutConstant>
                            <threads>4</threads>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <outputFormat>XML</outputFormat>
                                <outputFormat>HTML</outputFormat>
                            </outputFormats>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <!-- JaCoCo y PIT inyectan su propio agente: se quita el de JaCoCo de la JVM de PIT. -->
                            <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
