<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.usac.jobseeker</groupId>
        <artifactId>jobseeker-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ats-module</artifactId>
    <packaging>jar</packaging>

    <name>ats-module</name>
    <description>Módulo ats: la postulación y el pipeline del reclutador. Ver docs/03-architecture/tdd/ats-tracker-modules.md.</description>

    <!-- Los starters de Spring Boot y las dependencias propias del módulo se añadirán más adelante. -->

    <dependencies>
        <dependency>
            <groupId>com.usac.jobseeker</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Los módulos que `ats` consulta al postular, siempre por sus casos de uso públicos y solo desde
             infrastructure.adapter (ARCH-04): auth (capacidad), cv (BR-CAND-01), job (si la vacante acepta
             postulaciones) y matching (copia del perfil, TD-040). Ninguno depende de ats (ARCH-05, ARCH-06).
             Sus migraciones vienen con ellos, así las claves foráneas de `applications` se prueban aquí. -->
        <dependency>
            <groupId>com.usac.jobseeker</groupId>
            <artifactId>auth-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.usac.jobseeker</groupId>
            <artifactId>cv-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.usac.jobseeker</groupId>
            <artifactId>job-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.usac.jobseeker</groupId>
            <artifactId>matching-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Transacciones en application (ADR-0015, ARCH-02); JDBC y configuración solo en infrastructure. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- Log estructurado de los casos de uso (ADR-0012): solo la API, el motor lo pone `app`. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Adaptador de entrada web (ARCH-08: los controladores viven en infrastructure.adapter.in.web) y las
             anotaciones de OpenAPI que lo documentan (ADR-0010); el generador (springdoc) vive solo en `app`. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- El adaptador JDBC se prueba en este módulo, contra la tabla real que su propia migración crea
             (Postgres 17, ADR-0028): un módulo prueba sus adaptadores sin depender de `app`. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
